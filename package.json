{
  "name": "dsh-ui-zoom-regions",
  "version": "1.2.0",
  "description": "Per-region UI zoom for DeepSeek Harness, with a two-channel header: Ctrl + wheel scales the header font (25 %-300 %), dragging the header bottom edge changes how much room the header takes (24 px up to half the conversation panel) without touching the font. The sidebars zoom 25 %-300 %; the centre column 50 %-200 %.",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "zoom",
    "scale",
    "ui",
    "per-region",
    "header-resize",
    "accessibility"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/FurinaEsE/dsh-ui-zoom-regions.git"
  },
  "homepage": "https://github.com/FurinaEsE/dsh-ui-zoom-regions#readme",
  "bugs": {
    "url": "https://github.com/FurinaEsE/dsh-ui-zoom-regions/issues"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-runtime"
      ],
      "platform": "web",
      "immediately": true
    }
  }
}
